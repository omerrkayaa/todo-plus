{
  "name": "todo-plus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.16.0" },
  "scripts": {
    "start": "node server/index.js",
    "test:server": "node --test server/tests/*.test.js",
    "test:merge": "node --test tests/sync-merge.test.mjs",
    "test:unit": "node --test tests/utils-and-parser.test.mjs",
    "test:offline": "node scripts/offline-sync-test.mjs",
    "test:pwa": "node scripts/pwa-test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:node": "npm run test:server && npm run test:merge && npm run test:unit",
    "test:all": "npm run test:server && npm test",
    "test": "npm run test:merge && npm run test:unit && node scripts/smoke-test.mjs && npm run test:offline && npm run test:pwa",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.10.0",
    "pdf-parse": "2.4.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "pdfkit": "^0.17.2",
    "playwright": "^1.53.0"
  }
}
